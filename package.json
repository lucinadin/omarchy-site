{
  "name": "omarchy-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:cn": "cn build --content \"app/**/*.ts\" --content \"app/**/*.tsx\" --content \"components/**/*.ts\" --content \"components/**/*.tsx\" --content \"features/**/*.ts\" --content \"features/**/*.tsx\" --content \"lib/**/*.ts\" --content \"lib/**/*.tsx\" --content \"providers/**/*.ts\" --content \"providers/**/*.tsx\" --config cn.config.ts -o cn-tables.ts",
    "preanalyze:bundle": "bun run prepare:cn",
    "analyze:bundle": "next experimental-analyze --output",
    "predev": "bun run prepare:cn",
    "dev": "next dev",
    "prebuild": "bun run prepare:cn && bun run static:generate && bun run og:generate",
    "build": "next build",
    "og:preview": "bun --conditions=react-server scripts/generate-og-images.ts --preview",
    "og:generate": "bun --conditions=react-server scripts/generate-og-images.ts",
    "static:generate": "bun --conditions=react-server scripts/generate-static-files.ts",
    "sync:news": "bun scripts/sync-upstream-news.ts",
    "sync:news:check": "bun scripts/sync-upstream-news.ts --check",
    "sync:themes": "bun scripts/sync-community-themes.ts",
    "sync:themes:check": "bun scripts/sync-community-themes.ts --check",
    "optimize:wallpapers": "bun scripts/optimize-wallpapers.ts",
    "start": "next start",
    "audit:logo-effects": "bun scripts/audit-logo-effects.ts",
    "audit:knip": "knip --no-progress --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "audit:wgsl": "bun scripts/audit-wgsl.ts",
    "audit:wgsl:device": "bun scripts/audit-wgsl.ts --require-validation",
    "audit:css-tokens": "bun scripts/audit-css-tokens.ts",
    "audit:css-dead": "bun scripts/audit-dead-css.ts",
    "lint": "oxlint --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix --report-unused-disable-directives .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "pretypecheck": "bun run prepare:cn",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test && bun run audit:css-tokens && bun run audit:css-dead && bun run audit:logo-effects && bun run audit:wgsl && bun run audit:knip && bun run build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.0-canary.15",
    "@vgpu/wgsl": "0.3.1",
    "@wterm/dom": "0.3.4",
    "@wterm/react": "0.3.4",
    "class-variance-authority": "0.7.1",
    "cn": "latest",
    "github-slugger": "2.0.0",
    "next": "^16.4.0-canary.19",
    "react": "canary",
    "react-dom": "canary",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@webgpu/types": "0.1.72",
    "knip": "6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "postcss": "^8.5.28",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "packageManager": "bun@1.4.0"
}
